diff --git a/CMakeLists.txt b/CMakeLists.txt
index f5e0ef5..b2c8841 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -66,6 +66,9 @@ endif()
 
 find_package(fmt CONFIG REQUIRED)
 find_package(spdlog CONFIG REQUIRED)
+
+# fmt / spdlog 使用 header-only 模式，代码直接编译进产物，消除对 .so 的依赖
+add_compile_definitions(FMT_HEADER_ONLY SPDLOG_HEADER_ONLY)
 find_package(Protobuf CONFIG REQUIRED)
 find_package(yaml-cpp CONFIG REQUIRED)
 find_package(gRPC CONFIG REQUIRED)
@@ -126,9 +129,30 @@ target_include_directories(adviskv_proto PUBLIC
     ${ADVISKV_GENERATED_DIR}
 )
 
+# 静态链接 protobuf / gRPC 及全部传递依赖（absl、c-ares、re2、upb、ssl 等），
+# 使最终产物不再依赖这些库的 .so 版本。
+# 注意：c-ares 静态库在 Ubuntu 上名为 libcares_static.a；
+# 静态库间存在循环依赖，用 --start-group/--end-group 让链接器自动解析。
+file(GLOB ADVISKV_ABSL_STATIC_LIBS /usr/lib/x86_64-linux-gnu/libabsl_*.a)
+set(ADVISKV_GRPC_STATIC_LIBS
+    /usr/lib/x86_64-linux-gnu/libgrpc++.a
+    /usr/lib/x86_64-linux-gnu/libgrpc.a
+    /usr/lib/x86_64-linux-gnu/libaddress_sorting.a
+    /usr/lib/x86_64-linux-gnu/libre2.a
+    /usr/lib/x86_64-linux-gnu/libupb.a
+    /usr/lib/x86_64-linux-gnu/libcares_static.a
+    /usr/lib/x86_64-linux-gnu/libz.a
+    /usr/lib/x86_64-linux-gnu/libgpr.a
+    ${ADVISKV_ABSL_STATIC_LIBS}
+    /usr/lib/x86_64-linux-gnu/libssl.a
+    /usr/lib/x86_64-linux-gnu/libcrypto.a
+)
 target_link_libraries(adviskv_proto PUBLIC
-    protobuf::libprotobuf
-    gRPC::grpc++
+    /usr/lib/x86_64-linux-gnu/libprotobuf.a
+    -Wl,--start-group
+    ${ADVISKV_GRPC_STATIC_LIBS}
+    -Wl,--end-group
+    atomic
 )
 
 # adviskv_proto 的代码禁掉 warning
@@ -141,9 +165,11 @@ enable_testing()
 set(CMAKE_RUNTIME_OUTPUT_DIRECTORY ${CMAKE_BINARY_DIR}/bin)
 
 add_subdirectory(src)
-add_subdirectory(tools/cli)
-add_subdirectory(tools/storage_client)
-add_subdirectory(tools/e2e)
