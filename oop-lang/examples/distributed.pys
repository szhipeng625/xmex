# 分布式节点创建测试 —— Xmex 版本
# 调用 kv / cluster / raft 模块接口

print("=== 分布式节点创建测试 (Xmex) ===")
print("")

# 1. 通过 kv 模块构建三个分布式节点
print("1. 通过 kv.build 构建分布式节点")

r1 = kv.build("node-1", "/usr/bin/raft-node", "[]", "/tmp/raft-node-1", "127.0.0.1:9001")
print("   node-1:", r1)

r2 = kv.build("node-2", "/usr/bin/raft-node", "[]", "/tmp/raft-node-2", "127.0.0.1:9002")
print("   node-2:", r2)

r3 = kv.build("node-3", "/usr/bin/raft-node", "[]", "/tmp/raft-node-3", "127.0.0.1:9003")
print("   node-3:", r3)

# 2. 查看 kv 管理的节点列表
print("")
print("2. kv.list() 节点列表")
nodes = kv.list()
print("   节点列表:", nodes)

# 3. 查看各节点存活状态
print("")
print("3. 节点存活检查")
print("   node-1 存活:", kv.alive("node-1"))
print("   node-2 存活:", kv.alive("node-2"))
print("   node-3 存活:", kv.alive("node-3"))

# 4. 通过 cluster 模块组建集群
print("")
print("4. cluster.connect 组建集群")
c1 = cluster.connect("my-cluster", "127.0.0.1:9001", "")
print("   node-1 加入集群:", c1)

c2 = cluster.connect("my-cluster", "127.0.0.1:9002", "")
print("   node-2 加入集群:", c2)

c3 = cluster.connect("my-cluster", "127.0.0.1:9003", "")
print("   node-3 加入集群:", c3)

# 5. 查看集群列表
print("")
print("5. cluster.list() 集群列表")
clusters = cluster.list()
print("   集群列表:", clusters)

# 6. 查看集群状态
print("")
print("6. cluster.status 集群状态")
cs = cluster.status("my-cluster")
print("   集群状态:", cs)

# 7. 健康检查
print("")
print("7. 健康检查")
print("   my-cluster 健康:", cluster.health("my-cluster"))
print("   全部集群健康:", cluster.health_all())

# 8. 查看 raft 全局节点
print("")
print("8. raft.list_nodes() 全局节点")
raft_nodes = raft.list_nodes()
print("   全局节点:", raft_nodes)

print("")
print("=== 测试完成 ===")
print("成功通过 Xmex 调用 kv/cluster/raft 模块创建分布式节点并组建集群。")
